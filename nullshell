show_owner() {
  printf '\n'
  printf '   %sTool%s    : %s v%s\n' "$D" "$N" "$TOOL_NAME" "$TOOL_VER"
  printf '   %sOwner%s   : %s%s%s\n' "$D" "$N" "$Y" "$OWNER_NAME" "$N"
  printf '   %sGitHub%s  : %s%s%s\n' "$D" "$N" "$W" "$OWNER_GH" "$N"
  printf '   %sTelegram%s: %s%s%s\n' "$D" "$N" "$BL" "$OWNER_TG" "$N"
  printf '   %sInsta%s   : %s%s%s\n' "$D" "$N" "$MG" "$OWNER_IG" "$N"
  printf '\n'
}

main() {
  verify_owner
  command -v clear >/dev/null 2>&1 && clear
  banner
  need_env
  case "${1:-}" in
    --help|-h) usage; exit 0 ;;
    --owner) show_owner; exit 0 ;;
    --version|-v) echo "$TOOL_NAME v$TOOL_VER"; exit 0 ;;
  esac
  install_pkgs
  setup_java
  get_android_jar
  pick_dexer
  case "${1:-}" in
    --setup) get_keystore; ok "Setup complete."; exit 0 ;;
    --install) install_self; exit 0 ;;
    --clean) clean_all "${2:-$PWD}"; exit 0 ;;
    --all) build_all "${2:-$PWD}"; exit 0 ;;
    --jar) build_jar "${2:-$PWD}"; exit 0 ;;
    --apk) build_apk "${2:-$PWD}"; exit 0 ;;
    --run) build_jar "${2:-$PWD}"; cd "${2:-$PWD}" 2>/dev/null; [ -f NullShell/app.jar ] && java -jar NullShell/app.jar || warn "JAR nahi mila."; exit 0 ;;
    *) dispatch_build "${1:-$PWD}" ;;
  esac
}

main "$@"
