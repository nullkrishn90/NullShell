find_manifest() {
  local cand
  for cand in AndroidManifest.xml app/src/main/AndroidManifest.xml src/main/AndroidManifest.xml; do
    [ -f "$cand" ] && { printf '%s' "$cand"; return 0; }
  done
  local found
  found=$(find . -maxdepth 5 -name AndroidManifest.xml -not -path '*/.nullshell-build/*' 2>/dev/null | head -1)
  [ -n "$found" ] && printf '%s' "${found#./}"
}

scaffold_project() {
  local root="$1"; cd "$root" 2>/dev/null || die "Folder me ja nahi paya: $root"
  local raw appname pkg pkgpath
  raw="$(basename "$root")"
  appname="$(printf '%s' "$raw" | tr -cd 'A-Za-z0-9 _-')"; [ -z "$appname" ] && appname="NullApp"
  pkg="com.nullshell.$(printf '%s' "$raw" | tr -cd 'a-z0-9' | tr 'A-Z' 'a-z')"
  [ "$pkg" = "com.nullshell." ] && pkg="com.nullshell.app"
  pkgpath="$(printf '%s' "$pkg" | tr '.' '/')"
  mkdir -p "res/layout" "res/values" "src/$pkgpath"
  cat > AndroidManifest.xml <<EOF
<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="$pkg" android:versionCode="1" android:versionName="1.0">
    <uses-sdk android:minSdkVersion="$MINSDK" android:targetSdkVersion="$TARGETSDK" />
    <application android:label="$appname" android:allowBackup="true"
        android:debuggable="true" android:theme="@android:style/Theme.DeviceDefault">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
EOF
  cat > res/values/strings.xml <<EOF
<?xml version="1.0" encoding="utf-8"?>
<resources><string name="app_name">$appname</string><string name="tagline">NullShell se build hua!</string></resources>
EOF
  cat > res/layout/activity_main.xml <<'EOF'
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center" android:background="#0D0D0D" android:padding="24dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="@string/app_name" android:textColor="#FF1744" android:textSize="30sp" android:textStyle="bold" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:text="@string/tagline" android:textColor="#FFFFFF" android:textSize="16sp" />
</LinearLayout>
EOF
  cat > "src/$pkgpath/MainActivity.java" <<EOF
package $pkg;
import android.app.Activity;
import android.os.Bundle;
import android.widget.Toast;
public class MainActivity extends Activity {
    @Override protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        setContentView(R.layout.activity_main);
        Toast.makeText(this, "NullShell build OK!", Toast.LENGTH_LONG).show();
    }
}
EOF
  ok "Starter app bana diya (package: $pkg)."
}

locate_or_scaffold() {
  local root="$1"; cd "$root" 2>/dev/null || die "Folder nahi mila: $root"
  local m; m="$(find_manifest)"
  if [ -n "$m" ]; then cd "$(dirname "$m")" || die "Manifest folder me ja nahi paya."; ok "Manifest mila: $PWD"; return 0; fi
  warn "Koi project nahi mila - starter app bana raha hoon..."
  scaffold_project "$root"
}

prepare_manifest() {
  local B="$1"; local M="$B/AndroidManifest.xml"
  cp AndroidManifest.xml "$M"
  # auto-generate a package name if the manifest has none
  if ! grep -qE 'package="[^"]+"' "$M"; then
    local apkg="com.nullshell.$(basename "$PWD" | tr -cd 'a-z0-9')"
    [ "$apkg" = "com.nullshell." ] && apkg="com.nullshell.app"
    sed -i -E "s#(<manifest)#\1 package=\"$apkg\"#" "$M"
  fi
  sed -i -E 's/ *android:maxSdkVersion="[0-9]+"//g' "$M"
  sed -i -E "s/android:minSdkVersion=\"[0-9]+\"/android:minSdkVersion=\"$MINSDK\"/g" "$M"
  sed -i -E "s/android:targetSdkVersion=\"[0-9]+\"/android:targetSdkVersion=\"$TARGETSDK\"/g" "$M"
  if grep -q '<uses-sdk' "$M"; then
    grep -q 'minSdkVersion' "$M"    || sed -i -E "s#(<uses-sdk)#\1 android:minSdkVersion=\"$MINSDK\"#" "$M"
    grep -q 'targetSdkVersion' "$M" || sed -i -E "s#(<uses-sdk)#\1 android:targetSdkVersion=\"$TARGETSDK\"#" "$M"
  fi
}

collect_jars() {
  JARS=()
  local jd j
  for jd in libs jars ../libs ../../libs ../../../libs app/libs; do
    [ -d "$jd" ] || continue
    while IFS= read -r j; do JARS+=("$j"); done < <(find "$jd" -maxdepth 2 -name '*.jar' 2>/dev/null)
  done
  JARCP=""
  [ ${#JARS[@]} -gt 0 ] && { JARCP="$(printf '%s:' "${JARS[@]}")"; ok "${#JARS[@]} library jar mile."; }
}

collect_native() {
  local B="$1" n=0 so abi d
  mkdir -p "$B/native"
  for d in lib jniLibs app/src/main/jniLibs app/libs; do
    [ -d "$d" ] || continue
    while IFS= read -r so; do
      abi="$(basename "$(dirname "$so")")"
      mkdir -p "$B/native/lib/$abi"; cp "$so" "$B/native/lib/$abi/" 2>/dev/null && n=$((n+1))
    done < <(find "$d" -name '*.so' 2>/dev/null)
  done
  NATIVE_COUNT="$n"; [ "$n" -gt 0 ] && ok "$n native lib(s) mile."
}

show_javac_errors() {
  local B="$1"
  warn "Compile errors (pehle 10):"
  grep -E 'error:' "$B/javac.log" 2>/dev/null | head -10 | sed "s/^/   ${R}|${N} /"
  grep -qE 'package .* does not exist' "$B/javac.log" 2>/dev/null && \
    printf '   %sHint: library missing -> us library ka .jar libs/ me rakho.%s\n' "$D" "$N"
  printf '   %sFull log: %s%s\n' "$D" "$B/javac.log" "$N"
}

# android-mode compile (android.jar + jars)
try_javac() {
  local B="$1" rel="$2"
  rm -rf "$B/classes"; mkdir -p "$B/classes"
  if [ -n "$rel" ]; then
    "$JAVA_HOME/bin/javac" --release "$rel" -encoding UTF-8 -d "$B/classes" -cp "$ANDROID_JAR:$JARCP" @"$B/sources.txt" > "$B/javac.log" 2>&1
  else
    "$JAVA_HOME/bin/javac" -encoding UTF-8 -d "$B/classes" -cp "$ANDROID_JAR:$JARCP" @"$B/sources.txt" > "$B/javac.log" 2>&1
  fi
}
# plain-java compile (no android.jar)
try_javac_plain() {
  local B="$1" rel="$2"
  rm -rf "$B/classes"; mkdir -p "$B/classes"
  if [ -n "$rel" ]; then
    "$JAVA_HOME/bin/javac" --release "$rel" -encoding UTF-8 -d "$B/classes" ${JARCP:+-cp "$JARCP"} @"$B/sources.txt" > "$B/javac.log" 2>&1
  else
    "$JAVA_HOME/bin/javac" -encoding UTF-8 -d "$B/classes" ${JARCP:+-cp "$JARCP"} @"$B/sources.txt" > "$B/javac.log" 2>&1
  fi
}

#---------------------------------------------------------------------
# ANDROID APK build
#---------------------------------------------------------------------
build_apk() {
  local dir="${1:-$PWD}"
  locate_or_scaffold "$dir"
  [ -f AndroidManifest.xml ] || die "AndroidManifest.xml nahi mila: $PWD"
  load_conf; get_keystore
  [ -n "$DEXER" ] || die "APK build ke liye d8/dx chahiye (pkg install d8)."
  [ -s "$ANDROID_JAR" ] || die "android.jar nahi mila."

  log "Project (Android): $PWD"
  local PKG LABEL NAME
  PKG=$(grep -oE 'package="[^"]+"' AndroidManifest.xml | head -1 | sed 's/package="//; s/"//')
  LABEL=$(grep -oE 'android:label="[^"]+"' AndroidManifest.xml | head -1 | sed 's/android:label="//; s/"//')
  if [ -z "$PKG" ]; then
    PKG="com.nullshell.$(basename "$PWD" | tr -cd 'a-z0-9')"
    [ "$PKG" = "com.nullshell." ] && PKG="com.nullshell.app"
    warn "Manifest me package= nahi mila -> auto: $PKG"
  fi
  case "$LABEL" in ""|@string/*) LABEL="${PKG##*.}";; esac
  NAME=$(printf '%s' "$LABEL" | tr -d ' /\\:*?"<>|'); [ -n "$APPNAME_OVERRIDE" ] && NAME="$APPNAME_OVERRIDE"

  printf '   %spackage%s   : %s\n   %sminSdk%s : %s %s(forced)%s   %stargetSdk%s : %s %s(forced)%s\n' \
         "$D" "$N" "$PKG" "$D" "$N" "$MINSDK" "$D" "$N" "$D" "$N" "$TARGETSDK" "$D" "$N"

  local RESDIR="" ASSETDIR="" d
  for d in res app/src/main/res; do [ -d "$d" ] && RESDIR="$d" && break; done
  for d in assets app/src/main/assets; do [ -d "$d" ] && ASSETDIR="$d" && break; done
  local SRCDIRS=()
  for d in src java app/src/main/java gen; do [ -d "$d" ] && SRCDIRS+=("$d"); done
  [ ${#SRCDIRS[@]} -gt 0 ] || die "Koi source folder (src/ ya java/) nahi mila."

  collect_jars
  local B="$PWD/.nullshell-build"; rm -rf "$B"; mkdir -p "$B/gen" "$B/classes" "$B/dex" "$B/out"
  prepare_manifest "$B"; collect_native "$B"

  step 1 "Resources compile (aapt2)..."
  local LINK_INPUT=""
  if [ -n "$RESDIR" ]; then
    aapt2 compile --dir "$RESDIR" -o "$B/res.zip" 2> "$B/aapt2.log" || { grep -E 'error' "$B/aapt2.log" | head -5 | sed "s/^/   ${R}|${N} /"; die "aapt2 compile fail."; }
    LINK_INPUT="$B/res.zip"; ok "Resources compiled."
  else warn "res/ nahi mila."; fi

  step 2 "Manifest + resources link (aapt2)..."
  local LINK_ARGS=(-I "$ANDROID_JAR" --manifest "$B/AndroidManifest.xml" --java "$B/gen"
                   -o "$B/out/base.apk" --auto-add-overlay --min-sdk-version "$MINSDK" --target-sdk-version "$TARGETSDK")
  [ -n "$ASSETDIR" ] && LINK_ARGS+=(-A "$ASSETDIR")
  [ -n "$LINK_INPUT" ] && LINK_ARGS+=("$LINK_INPUT")
  aapt2 link "${LINK_ARGS[@]}" 2> "$B/link.log" || { grep -E 'error' "$B/link.log" | head -8 | sed "s/^/   ${R}|${N} /"; die "aapt2 link fail."; }
  ok "Resources linked, R.java generated."

  step 3 "Java compile (javac, auto-release)..."
  find "${SRCDIRS[@]}" -name '*.java' ! -name 'R.java' > "$B/sources.txt" 2>/dev/null
  find "$B/gen" -name '*.java' >> "$B/sources.txt" 2>/dev/null
  [ -s "$B/sources.txt" ] || die "Koi .java file nahi mili."
  local compiled=0 rel
  if [ -n "$JAVAC_RELEASE" ]; then try_javac "$B" "$JAVAC_RELEASE" && compiled=1
  else for rel in 9 8 11 17; do try_javac "$B" "$rel" && { compiled=1; JAVAC_USED="$rel"; break; }; done; fi
  [ "$compiled" = 1 ] || { show_javac_errors "$B"; die "Java compile fail."; }
  ok "Java compiled ($(wc -l < "$B/sources.txt") file, release=${JAVAC_USED:-$JAVAC_RELEASE})."

  step 4 "DEX convert ($DEXER, multi-dex)..."
  local CLS=(); mapfile -t CLS < <(find "$B/classes" -name '*.class')
  [ ${#CLS[@]} -gt 0 ] || die "Koi .class nahi bana."
  if [ "$DEXER" = "d8" ]; then
    d8 --lib "$ANDROID_JAR" ${JARCP:+--classpath "$JARCP"} --min-api "$MINSDK" --output "$B/dex" "${JARS[@]}" "${CLS[@]}" 2> "$B/d8.log" \
       || { grep -E 'error|Error' "$B/d8.log" | head -6 | sed "s/^/   ${R}|${N} /"; die "d8 fail."; }
  else
    dx --dex --output="$B/dex/classes.dex" ${JARCP:+--classpath "$JARCP"} "${CLS[@]}" 2> "$B/dx.log" || die "dx fail."
  fi
  local DEXES=(); while IFS= read -r df; do DEXES+=("$df"); done < <(find "$B/dex" -name '*.dex')
  [ ${#DEXES[@]} -gt 0 ] || die "Koi classes.dex nahi bana."
  ok "${#DEXES[@]} dex file(s) ready."

  step 5 "Package + align..."
  cp "$B/out/base.apk" "$B/out/unsigned.apk"
  zip -ujq "$B/out/unsigned.apk" "${DEXES[@]}" || die "dex add nahi hua."
  [ -d "$B/native/lib" ] && { ( cd "$B/native" && zip -rq "$B/out/unsigned.apk" lib ) && ok "$NATIVE_COUNT native lib(s) added."; }
  if command -v zipalign >/dev/null 2>&1; then
    zipalign -f -p 4 "$B/out/unsigned.apk" "$B/out/aligned.apk" && ok "APK aligned." || { cp "$B/out/unsigned.apk" "$B/out/aligned.apk"; warn "zipalign skip."; }
  else cp "$B/out/unsigned.apk" "$B/out/aligned.apk"; warn "zipalign skip."; fi

  step 6 "Sign (apksigner)..."
  mkdir -p "NullShell"; local OUT="NullShell/${NAME}.apk"
  if [ "$SKIP_SIGN" = "1" ]; then cp "$B/out/aligned.apk" "$OUT"; warn "SKIP_SIGN=1 -> unsigned."
  else
    apksigner sign --ks "$KS" --ks-pass "pass:$KSPASS" --ks-key-alias "$KSALIAS" --key-pass "pass:$KSPASS" \
       --min-sdk-version "$MINSDK" --v1-signing-enabled true --v2-signing-enabled true --v3-signing-enabled true \
       --out "$OUT" "$B/out/aligned.apk" || die "apksigner fail."
    ok "APK signed."
    [ -d "$HOME_T/storage/downloads" ] && cp "$OUT" "$HOME_T/storage/downloads/${NAME}.apk" 2>/dev/null && ok "Copy: /sdcard/Download/${NAME}.apk"
    apksigner verify "$OUT" >/dev/null 2>&1 && ok "Signature verify PASS" || warn "Verify fail."
  fi
  local SIZE; SIZE=$(du -h "$OUT" 2>/dev/null | cut -f1)
  echo
  printf '%s      *  APK  BUILD  SUCCESS  *%s\n' "$GR" "$N"
  printf '      %sAPK%s    : %s%s%s\n'  "$D" "$N" "$W" "$PWD/$OUT" "$N"
  printf '      %sSize%s   : %s%s%s\n'  "$D" "$N" "$CY" "$SIZE" "$N"
  printf '      %sInstall%s: %stermux-open %s%s\n' "$D" "$N" "$GR" "$OUT" "$N"
  printf '      %sBuilt by %s  %s.%s  %sOwner %s%s\n' "$D" "$N" "$TOOL_NAME" "$D" "$N" "$D" "$OWNER_NAME" "$N"
  echo
}

#---------------------------------------------------------------------
# PURE JAVA (JVM) build -> runnable .jar
#---------------------------------------------------------------------
detect_main() {
  local srcfile="$1" f cls pkg
  while IFS= read -r f; do
    [ -f "$f" ] || continue
    if grep -qE 'public[[:space:]]+static[[:space:]]+void[[:space:]]+main[[:space:]]*\(' "$f"; then
      cls="$(basename "$f" .java)"
      pkg="$(grep -oE '^[[:space:]]*package[[:space:]]+[A-Za-z0-9_.]+' "$f" | head -1 | sed -E 's/.*package[[:space:]]+//')"
      if [ -n "$pkg" ]; then printf '%s.%s' "$pkg" "$cls"; else printf '%s' "$cls"; fi
      return 0
    fi
  done < "$srcfile"
  return 1
}

build_jar() {
  local dir="${1:-$PWD}"
  cd "$dir" 2>/dev/null || die "Folder nahi mila: $dir"
  load_conf
  log "Project (Java/JVM): $PWD"

  local SRCDIRS=() d
  for d in src java Java app/src/main/java; do [ -d "$d" ] && SRCDIRS+=("$d"); done
  [ ${#SRCDIRS[@]} -eq 0 ] && SRCDIRS=(".")
  collect_jars

  local B="$PWD/.nullshell-build"; rm -rf "$B"; mkdir -p "$B/classes" "$B/out"
  find "${SRCDIRS[@]}" -name '*.java' 2>/dev/null | sort -u > "$B/sources.txt"
  [ -s "$B/sources.txt" ] || die "Koi .java file nahi mili."
  ok "$(wc -l < "$B/sources.txt") java file mili."

  step 1 "Java compile (javac, auto-release)..."
  local compiled=0 rel
  if [ -n "$JAVAC_RELEASE" ]; then try_javac_plain "$B" "$JAVAC_RELEASE" && compiled=1
  else for rel in 9 8 11 17; do try_javac_plain "$B" "$rel" && { compiled=1; JAVAC_USED="$rel"; break; }; done; fi
  [ "$compiled" = 1 ] || { show_javac_errors "$B"; die "Java compile fail."; }
  ok "Compiled (release=${JAVAC_USED:-$JAVAC_RELEASE})."

  step 2 "Main class detect..."
  local MAIN; MAIN="$(detect_main "$B/sources.txt")"
  [ -n "$MAIN" ] || die "public static void main(...) nahi mila. (Java app ke liye main() zaroori hai.)"
  ok "Main-Class: $MAIN"

  step 3 "JAR package..."
  printf 'Manifest-Version: 1.0\nMain-Class: %s\n\n' "$MAIN" > "$B/manifest.mf"
  mkdir -p "NullShell"
  local NAME; NAME="$(basename "$PWD")"; [ -n "$APPNAME_OVERRIDE" ] && NAME="$APPNAME_OVERRIDE"
  local OUT="NullShell/${NAME}.jar"
  local OUTABS="$PWD/$OUT"
  ( cd "$B/classes" && "$JAVA_HOME/bin/jar" cfm "$OUTABS" "$B/manifest.mf" . ) \
     || die "jar banane me fail."
  ok "JAR ready."
  cp "$OUT" "NullShell/app.jar" 2>/dev/null   # stable name (folder-naam se independent)

  # launcher (+ libs if any)
  if [ ${#JARS[@]} -gt 0 ]; then
    mkdir -p "NullShell/lib"; cp "${JARS[@]}" "NullShell/lib/" 2>/dev/null
    printf '#!/system/bin/sh\nDIR=$(dirname "$0")\nexec java -cp "$DIR/app.jar:$DIR/lib/*" %s "$@"\n' "$MAIN" > "NullShell/run.sh"
    ok "${#JARS[@]} library jar saath rakhe."
  else
    printf '#!/system/bin/sh\nDIR=$(dirname "$0")\nexec java -jar "$DIR/app.jar" "$@"\n' > "NullShell/run.sh"
  fi
  chmod +x "NullShell/run.sh" 2>/dev/null

  local SIZE; SIZE=$(du -h "$OUT" 2>/dev/null | cut -f1)
  echo
  printf '%s      *  JAVA  BUILD  SUCCESS  *%s\n' "$GR" "$N"
  printf '      %sJAR%s    : %s%s%s\n' "$D" "$N" "$W" "$PWD/$OUT" "$N"
  printf '      %sAlso%s   : %sNullShell/app.jar%s  %s(stable naam)%s\n' "$D" "$N" "$W" "$N" "$D" "$N"
  printf '      %sMain%s   : %s%s%s\n' "$D" "$N" "$CY" "$MAIN" "$N"
  printf '      %sSize%s   : %s%s%s\n' "$D" "$N" "$CY" "$SIZE" "$N"
  printf '      %sRun%s    : %sjava -jar NullShell/app.jar%s   %s(ya: sh NullShell/run.sh)%s\n' "$D" "$N" "$GR" "$N" "$D" "$N"
  printf '      %sBuilt by %s  %s.%s  %sOwner %s%s\n' "$D" "$N" "$TOOL_NAME" "$D" "$N" "$D" "$OWNER_NAME" "$N"
  echo
}

#---------------------------------------------------------------------
# Dispatch: Android (manifest) vs Java (main)
#---------------------------------------------------------------------
dispatch_build() {
  local dir="${1:-$PWD}"
  cd "$dir" 2>/dev/null || die "Folder nahi mila: $dir"

  # 1) Android project here?
  local m; m="$(find_manifest)"
  if [ -n "$m" ]; then build_apk "$PWD"; return; fi

  # 2) Pure Java project here? (top-level .java, or src/ java/ folder)
  local selfjava=0
  [ -n "$(find . -maxdepth 1 -name '*.java' 2>/dev/null | head -1)" ] && selfjava=1
  { [ -d src ] || [ -d java ] || [ -d Java ]; } && selfjava=1
  if [ "$selfjava" = 1 ]; then
    log "Java (JVM) mode."
    build_jar "$PWD"; return
  fi

  # 3) no project at this level -> build EVERY buildable subfolder (app/, Java/, ...)
  local subs=() d
  for d in */; do
    [ -d "$d" ] || continue
    d="${d%/}"
    case "$d" in .nullshell-build|toolz|NullShell) continue ;; esac
    if [ -f "$d/AndroidManifest.xml" ] || [ -f "$d/app/src/main/AndroidManifest.xml" ] \
       || find "$d" -maxdepth 3 -name '*.java' 2>/dev/null | grep -q .; then
      subs+=("$d")
    fi
  done
  if [ ${#subs[@]} -gt 0 ]; then
    log "Multiple projects mile - sab build kar raha hoon: ${subs[*]}"
    for d in "${subs[@]}"; do
      echo
      printf '%s   =================  %s  =================%s\n' "$CY" "$d" "$N"
      dispatch_build "$PWD/$d"
    done
    return
  fi

  # 4) nothing anywhere -> scaffold an Android project and build it
  build_apk "$PWD"
}

build_all() {
  local dir="${1:-$PWD}"; cd "$dir" 2>/dev/null || die "Folder nahi mila: $dir"
  local subs=() d
  for d in */; do
    [ -d "$d" ] || continue
    d="${d%/}"
    case "$d" in .nullshell-build|toolz|NullShell) continue ;; esac
    if [ -f "$d/AndroidManifest.xml" ] || [ -f "$d/app/src/main/AndroidManifest.xml" ] \
       || find "$d" -maxdepth 3 -name '*.java' 2>/dev/null | grep -q .; then
      subs+=("$d")
    fi
  done
  [ ${#subs[@]} -gt 0 ] || die "Koi buildable sub-project nahi mila."
  log "Sab build kar raha hoon: ${subs[*]}"
  for d in "${subs[@]}"; do
    echo; printf '%s   =================  %s  =================%s\n' "$CY" "$d" "$N"
    dispatch_build "$PWD/$d"
  done
}

clean_all() {
  local dir="${1:-$PWD}"
  cd "$dir" 2>/dev/null || die "Folder nahi mila: $dir"
  find "$PWD" -maxdepth 4 -type d -name '.nullshell-build' -exec rm -rf {} + 2>/dev/null
  rm -rf "$PWD/NullShell"
  ok "Clean done."
}

install_self() {
  mkdir -p "$PREFIX/bin" "$TOOLZ"
  [ -f "$SELF" ] && { cp "$SELF" "$PREFIX/bin/nullshell" 2>/dev/null || cat "$SELF" > "$PREFIX/bin/nullshell"; } || die "Install fail."
  chmod +x "$PREFIX/bin/nullshell"; cp "$PREFIX/bin/nullshell" "$PREFIX/bin/NullShell" 2>/dev/null; chmod +x "$PREFIX/bin/NullShell"
  if [ ! -s "$ANDROID_JAR" ]; then
    if [ -n "$SELF_DIR" ] && [ -s "$SELF_DIR/toolz/android.jar" ]; then cp "$SELF_DIR/toolz/android.jar" "$ANDROID_JAR"; ok "android.jar install (offline ready)."
    elif [ -s "./toolz/android.jar" ]; then cp "./toolz/android.jar" "$ANDROID_JAR"; ok "android.jar install (offline ready)."; fi
  fi
  ok "GLOBAL install ho gaya! Kahin bhi likho:  NullShell"
}

