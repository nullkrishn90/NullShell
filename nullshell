# detect environment: Termux vs generic Linux / macOS
IS_TERMUX=0
if command -v pkg >/dev/null 2>&1 && [ -d /data/data/com.termux ]; then IS_TERMUX=1; fi
if [ "$IS_TERMUX" = 1 ]; then
  PREFIX="${PREFIX:-/data/data/com.termux/files/usr}"
  HOME_T="${HOME:-/data/data/com.termux/files/home}"
else
  PREFIX="${PREFIX:-$HOME/.local}"
  HOME_T="${HOME:-/root}"
fi
BASE="$HOME_T/.nullshell"
TOOLZ="$BASE/toolz"
ANDROID_JAR="$TOOLZ/android.jar"
KS="${NULLSHELL_KS:-$BASE/nullshell.keystore}"
SELF="$0"
SELF_DIR="$(cd "$(dirname "$0")" 2>/dev/null && pwd)"
need_env() {
  if [ "$IS_TERMUX" = 1 ]; then
    [ -d /data/data/com.termux ] || die "Termux environment issue."
  fi
  # generic Linux/macOS is fine
}

install_pkgs() {
  local have=1
  command -v aapt2     >/dev/null 2>&1 || have=0
  command -v apksigner >/dev/null 2>&1 || have=0
  { command -v d8 >/dev/null 2>&1 || command -v dx >/dev/null 2>&1; } || have=0
  { command -v javac >/dev/null 2>&1 || ls "$PREFIX"/lib/jvm/java-*-openjdk/bin/javac >/dev/null 2>&1; } || have=0
  [ "$have" = 1 ] && { ok "Tools ready (install skip)."; return; }

  if [ "$IS_TERMUX" = 1 ]; then
    log "Termux: tools install..."
    pkg update -y >/dev/null 2>&1 || true
    pkg install -y openjdk-17 aapt2 apksigner zip unzip curl wget coreutils >/dev/null 2>&1 || true
    for p in d8 dx zipalign openssl; do pkg install -y "$p" >/dev/null 2>&1 || true; done
  elif command -v apt-get >/dev/null 2>&1; then
    log "Linux: installing Java + zip (apt)..."
    if command -v sudo >/dev/null 2>&1; then SUDO=sudo; else SUDO=""; fi
    $SUDO apt-get update -y >/dev/null 2>&1 || true
    $SUDO apt-get install -y openjdk-17-jdk-headless zip unzip curl wget ca-certificates >/dev/null 2>&1 || true
    warn "aapt2 / apksigner / d8 Linux repo me nahi hote - Android build-tools install karo (ya Docker use karo)."
  else
    warn "Package manager nahi mila - tools already installed hone chahiye."
  fi
  ok "Packages step done."
}

setup_java() {
  if [ -n "${JAVA_HOME:-}" ] && [ -x "${JAVA_HOME}/bin/javac" ]; then :; else
    JAVA_HOME=""
    for d in "$PREFIX"/lib/jvm/java-*-openjdk "$PREFIX"/opt/openjdk /usr/lib/jvm/*; do
      [ -x "$d/bin/javac" ] && JAVA_HOME="$d"
    done
  fi
  if [ -z "$JAVA_HOME" ] || [ ! -x "$JAVA_HOME/bin/javac" ]; then
    if command -v javac >/dev/null 2>&1; then
      JAVA_HOME="$(cd "$(dirname "$(command -v javac)")/.." && pwd)"
    fi
  fi
  [ -n "$JAVA_HOME" ] && [ -x "$JAVA_HOME/bin/javac" ] || die "Java (javac) nahi mila. Termux: pkg install openjdk-17 | Linux: apt install openjdk-17-jdk"
  export JAVA_HOME; export PATH="$JAVA_HOME/bin:$PATH"
  ok "Java: $($JAVA_HOME/bin/javac -version 2>&1)"
}

get_android_jar() {
  mkdir -p "$TOOLZ"
  [ -s "$ANDROID_JAR" ] && { ok "android.jar ready."; return; }
  if [ -n "$SELF_DIR" ] && [ -s "$SELF_DIR/toolz/android.jar" ]; then
    cp "$SELF_DIR/toolz/android.jar" "$ANDROID_JAR"; ok "Bundled android.jar use kiya."; return
  fi
  [ -s "./toolz/android.jar" ] && { cp ./toolz/android.jar "$ANDROID_JAR"; ok "android.jar mil gaya."; return; }
  # Android SDK platform jar (Linux / Docker / Windows+WSL)
  local sdkjar
  for sdkjar in "${ANDROID_SDK_ROOT:-}"/platforms/*/android.jar "${ANDROID_HOME:-}"/platforms/*/android.jar; do
    [ -s "$sdkjar" ] && { cp "$sdkjar" "$ANDROID_JAR"; ok "android.jar Android SDK se liya."; return; }
  done
  log "android.jar download..."
  local u urls=(
    "https://github.com/Sable/android-platforms/raw/master/android-30/android.jar"
    "https://raw.githubusercontent.com/Sable/android-platforms/master/android-30/android.jar"
  )
  for u in "${urls[@]}"; do
    if curl -L --fail --connect-timeout 20 -o "$ANDROID_JAR.tmp" "$u" 2>/dev/null && [ -s "$ANDROID_JAR.tmp" ]; then
      mv "$ANDROID_JAR.tmp" "$ANDROID_JAR"; ok "android.jar mil gaya."; return
    fi
  done
  rm -f "$ANDROID_JAR.tmp"; warn "android.jar nahi mila (APK build ke liye zaroori)."
}

get_keystore() {
  mkdir -p "$(dirname "$KS")"
  [ -f "$KS" ] && { ok "Keystore ready."; return; }
  keytool -genkeypair -keystore "$KS" -alias "$KSALIAS" -keyalg RSA -keysize 2048 \
     -validity 10000 -storepass "$KSPASS" -keypass "$KSPASS" \
     -dname "CN=${TOOL_NAME}, O=Termux, C=IN" >/dev/null 2>&1 \
     && ok "Keystore ready." || die "Keystore fail."
}

pick_dexer() {
  if command -v d8 >/dev/null 2>&1; then DEXER="d8"
  elif command -v dx >/dev/null 2>&1; then DEXER="dx"
  else DEXER=""; fi
  [ -n "$DEXER" ] && ok "DEX converter: $DEXER" || warn "d8/dx nahi mila (sirf Java build chalega)."
}

load_conf() {
  [ -f "nullshell.conf" ] || return 0
  local line k v
  while IFS= read -r line; do
    case "$line" in ''|\#*) continue;; esac
    k="${line%%=*}"; v="${line#*=}"
    k="$(printf '%s' "$k" | tr -d ' \t')"
    v="$(printf '%s' "$v" | sed -E 's/^[ \t]+//; s/[ \t]+$//')"
    case "$k" in
      MIN_SDK) MINSDK="$v";; TARGET_SDK) TARGETSDK="$v";; APP_NAME) APPNAME_OVERRIDE="$v";;
      KEYSTORE) KS="$v";; KS_PASS) KSPASS="$v";; KS_ALIAS) KSALIAS="$v";;
      SKIP_SIGN) SKIP_SIGN="$v";; JAVAC_RELEASE) JAVAC_RELEASE="$v";;
    esac
  done < <(grep -vE '^[[:space:]]*(#|$)' "nullshell.conf")
  ok "Config loaded."
}

